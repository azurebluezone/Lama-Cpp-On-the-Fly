{
  "schema": "lama.seed/v1",
  "identity": "identity.json",
  "providers": [
    {
      "id": "llamacpp",
      "name": "llama.cpp (stock)",
      "kind": "llamacpp",
      "base_url": "http://127.0.0.1:9933",
      "metadata": {
        "role": "engine-and-manager",
        "owner": "Sahon Srabon",
        "license": "MIT (llama.cpp)",
        "source": "https://github.com/ggml-org/llama.cpp",
        "note": "One OpenAI-compatible surface: gateway http://127.0.0.1:5252 proxies /v1 to the stock engine on 127.0.0.1:9932 (UDS /tmp/llama-1000/llama.sock). TLS edge: https://127.0.0.1:9931 via Caddy."
      }
    }
  ],
  "transports": [
    {
      "id": "http",
      "name": "HTTP loopback",
      "protocol": "http",
      "host": "127.0.0.1",
      "port": 9932,
      "metadata": {
        "scope": "loopback",
        "gateway": "Direct engine: http://127.0.0.1:9932. Admin API: 127.0.0.1:9933. Gateway: http://127.0.0.1:5252 (API, /admin, SSE). TLS edge: https://127.0.0.1:9931 via Caddy.",
        "env_to_engine": false
      }
    },
    {
      "id": "uds",
      "name": "Unix domain socket",
      "protocol": "uds",
      "socket_path": "/tmp/llama-1000/llama.sock",
      "metadata": {
        "scope": "loopback",
        "dir_mode": "0700",
        "socket_mode": "0660",
        "gateway": "Symlink the engine socket into the gateway folder (/home/sahon/zclama/gateway/llama.sock); never pass this path to llama.cpp as an environment variable.",
        "env_to_engine": false
      }
    },
    {
      "id": "https",
      "name": "HTTPS loopback (engine-native TLS)",
      "protocol": "https",
      "host": "127.0.0.1",
      "port": 9932,
      "metadata": {
        "scope": "loopback",
        "requires": "LAMA_TLS=1 and a stock OpenSSL build (engine-native TLS listens on LAMA_TLS_PORT=9931); with LAMA_TLS=0 use the Caddy edge https://127.0.0.1:9931",
        "env_to_engine": false,
        "tls_port": 9931
      }
    }
  ],
  "mcp_servers": [
    {
      "id": "lama-tools",
      "name": "lama-tools",
      "transport": "stdio",
      "command": "node",
      "args": [
        "src/mcp/server.ts"
      ],
      "env": {
        "LAMA_WORKSPACE": "/home/sahon/zclama/workspace"
      },
      "cwd": "/home/sahon/zclama",
      "timeout_ms": 30000,
      "enabled": 1,
      "metadata": {
        "tools": [
          "read_file",
          "write_file",
          "list_dir",
          "run_shell",
          "http_fetch"
        ],
        "scope": "workspace",
        "note": "llama.cpp accepts stdio MCP only; HTTP/SSE rows stay orchestrator-side."
      }
    }
  ],
  "documents": [
    {
      "id": "openai-http",
      "slug": "openai-http",
      "title": "OpenAI chat completions over HTTP",
      "transport_id": "http",
      "body": "curl -sS http://127.0.0.1:9933/v1/chat/completions -H 'content-type: application/json' -d '{\"model\":\"MODEL_ID\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"max_tokens\":64}'",
      "metadata": {
        "surface": "manager",
        "protocol": "openai",
        "auth": "loopback or LAMA_API_KEY",
        "note": "manager proxy; adds identity headers and optional LAMA_API_KEY auth"
      }
    },
    {
      "id": "anthropic-http",
      "slug": "anthropic-http",
      "title": "Anthropic Messages over HTTP",
      "transport_id": "http",
      "body": "curl -sS http://127.0.0.1:9933/v1/messages -H 'content-type: application/json' -d '{\"model\":\"MODEL_ID\",\"max_tokens\":64,\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}'",
      "metadata": {
        "surface": "manager",
        "protocol": "anthropic",
        "auth": "loopback or LAMA_API_KEY"
      }
    },
    {
      "id": "openai-uds",
      "slug": "openai-uds",
      "title": "OpenAI chat completions over UDS",
      "transport_id": "uds",
      "body": "curl -sS --unix-socket /tmp/llama-1000/llama.sock http://localhost/v1/chat/completions -H 'content-type: application/json' -d '{\"model\":\"MODEL_ID\",\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"max_tokens\":64}'",
      "metadata": {
        "surface": "engine",
        "protocol": "openai",
        "socket_mode": "0660"
      }
    },
    {
      "id": "anthropic-uds",
      "slug": "anthropic-uds",
      "title": "Anthropic Messages over UDS",
      "transport_id": "uds",
      "body": "curl -sS --unix-socket /tmp/llama-1000/llama.sock http://localhost/v1/messages -H 'content-type: application/json' -d '{\"model\":\"MODEL_ID\",\"max_tokens\":64,\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}'",
      "metadata": {
        "surface": "engine",
        "protocol": "anthropic",
        "socket_mode": "0660"
      }
    },
    {
      "id": "gateway",
      "slug": "gateway",
      "title": "Gateway connection on :5252",
      "transport_id": "http",
      "body": "Gateway data-plane provider: http://127.0.0.1:9931 (stock engine). Control plane: http://127.0.0.1:9933 (admin API, identity headers, /v1 proxy). Point the gateway at the engine so chat keeps working when the admin is stopped; model id seen by clients is llamacpp/<alias>. If LAMA_ENGINE_API_KEY is set, register that env var in the gateway as api_key_env.",
      "metadata": {
        "surface": "gateway",
        "port": 5252,
        "provider_kind": "llamacpp"
      }
    }
  ],
